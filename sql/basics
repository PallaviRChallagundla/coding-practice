-- Problem 1: American Cities | SELECT AND WHERE clauses (City table)
-- Source: HackerRank

1-- Logic:
-- Filter USA cities by Population > 100000

SELECT *
FROM CITY
WHERE CountryCode = 'USA'
AND Population > 100000;

2--Logic:
--Select name filed and filter USA cities by Population larger than 120000

SELECT NAME
FROM CITY
WHERE COUNTRYCODE = 'USA'
AND POPULATION > 120000;

3--Logic: 
--Fetch all columns and rows

SELECT *
FROM CITY;

4--Logic: 
--Filter by a particular ID

SELECT *
FROM CITY 
WHERE ID = 1661;

5--Logi
--Filter by a different city japan

SELECT *
FROM CITY
WHERE COUNTRYCODE = 'JPN';

6--Logic
--Filter by a column (name) and particular row (country name is Japan)

SELECT NAME
FROM CITY
WHERE COUNTRYCODE = 'JPN';

7--Logic
--Diff table name, select 2 fields(City, state) from that table(station)

SELECT CITY, STATE
FROM STATION;

8--Logic
--exclude duplicates from the answer while selecting 2 columns

SELECT DISTINCT CITY
FROM STATION
WHERE ID % 2 = 0  
ORDER BY CITY ASC;

9--logic
--Difference between unique and total city in station table 

SELECT COUNT(CITY) - COUNT(DISTINCT CITY) AS difference
FROM STATION;

10--Logic
--shortest, longest and query first that comes in order alphabetically 

(SELECT CITY, LENGTH(CITY) AS length
 FROM STATION
 ORDER BY LENGTH(CITY), CITY
 LIMIT 1)

UNION

(SELECT CITY, LENGTH(CITY) AS length
 FROM STATION
 ORDER BY LENGTH(CITY) DESC, CITY
 LIMIT 1);

11--Logic
--VWords starting with vowels and no duplicates

SELECT DISTINCT CITY
FROM STATION
WHERE LOWER(CITY) LIKE 'a%'
   OR LOWER(CITY) LIKE 'e%'
   OR LOWER(CITY) LIKE 'i%'
   OR LOWER(CITY) LIKE 'o%'
   OR LOWER(CITY) LIKE 'u%';

12--logic
--Words ending with vowels and no duplicates

SELECT DISTINCT CITY
FROM STATION
WHERE LOWER(CITY) LIKE '%a'
   OR LOWER(CITY) LIKE '%e'
   OR LOWER(CITY) LIKE '%i'
   OR LOWER(CITY) LIKE '%o'
   OR LOWER(CITY) LIKE '%u';
